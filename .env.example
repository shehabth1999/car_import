# Secrets this extension reads from the deployment's environment.
# They are NOT set in this file: on a fleet tenant add them in central →
# the deployment → Environment variables (the tenant's .env is rewritten from
# there on every push). On a developer machine, add them to the project's .env.

# Apify API token — Apify Console → Settings → API & Integrations.
# Used only to read mobile.de adverts (services/apify.py). Nothing runs through
# Apify until the switch car_import.mobile_de_backend is set to "apify".
APIFY_TOKEN=
